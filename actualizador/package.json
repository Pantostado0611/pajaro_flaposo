{
  "name": "actualizador",
  "productName": "Actualizador",
  "version": "1.2.0",
  "description": "Instala, actualiza y abre los juegos de Minijuegos",
  "author": "Burned Games",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.burnedgames.actualizador",
    "productName": "Actualizador",
    "executableName": "Actualizador",
    "files": [
      "main.js",
      "preload.js",
      "juegos.js",
      "ui.html",
      "imagenes/**",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Actualizador",
      "artifactName": "Actualizador-Instalador-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  }
}
